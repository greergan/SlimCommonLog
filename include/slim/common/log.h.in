#ifndef SLIM_COMMON_LOG_H
#define SLIM_COMMON_LOG_H
#include <functional>
#include <string>
#include <string_view>
#include <unistd.h>
#define SLIMCOMMONLOG_VERSION "@SLIMCOMMONLOG_VERSION@"
#define SLIMCOMMONLOG_GIT_HASH "@SLIMCOMMONLOG_GIT_HASH@"
namespace slim::common::log {
	struct Message {
	    Message() = delete;
	    Message(std::string_view function, std::string_view text, std::string_view file,
		const int line, std::string_view consumer = "console", std::string_view separator = "|");
		std::string_view consumer_;
		std::string_view function_;
		std::string_view file_;
		std::string_view text_;
		const int line_;
		std::string_view separator_;
		std::string_view label_;
		std::string_view log_level_;
		pid_t process_id_;
	};
	void set_can_log(std::function<bool(std::string_view consumer, std::string_view log_level,
	    std::string_view file, std::string_view function)> function);
	void error(Message message);
	void debug(Message message);
	void info(std::string_view string);
	void trace(Message message);
	void print(const Message& message);
}
#endif
